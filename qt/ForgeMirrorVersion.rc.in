#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
 PRODUCTVERSION @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Pharos\0"
            VALUE "FileDescription", "ForgeMirror Qt\0"
            VALUE "FileVersion", "@APP_VERSION@\0"
            VALUE "InternalName", "ForgeMirrorQt\0"
            VALUE "OriginalFilename", "ForgeMirrorQt.exe\0"
            VALUE "ProductName", "ForgeMirror\0"
            VALUE "ProductVersion", "@APP_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
